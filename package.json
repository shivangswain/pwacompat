{
  "name": "pwacompat",
  "version": "3.0.0",
  "description": "Fills the gaps between your Web App Manifest and Apple platforms: launch images, home screen icons and theme metadata for iOS, iPadOS and macOS Safari",
  "type": "module",
  "main": "./dist/pwacompat.min.js",
  "module": "./dist/pwacompat.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pwacompat.mjs",
      "default": "./dist/pwacompat.min.js"
    },
    "./pwacompat.min.js": "./dist/pwacompat.min.js",
    "./package.json": "./package.json"
  },
  "jsdelivr": "./dist/pwacompat.min.js",
  "unpkg": "./dist/pwacompat.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/pwacompat.min.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:browser",
    "release:assets": "node scripts/release-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivangswain/pwacompat.git"
  },
  "keywords": [
    "pwa",
    "web app manifest",
    "ios",
    "ipados",
    "macos",
    "safari",
    "splash screen",
    "apple-touch-startup-image",
    "apple-touch-icon"
  ],
  "author": "The Chromium Authors",
  "contributors": [
    "Shivang P Swain"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/shivangswain/pwacompat/issues"
  },
  "homepage": "https://github.com/shivangswain/pwacompat#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
